# Start Project.bat tu tao .env tu file nay neu chua co. Khong commit .env.
HF_TOKEN=

# Hạ tầng tự chọn khi bấm Start Project:
# auto = dùng Postgres/Redis qua Docker nếu chạy được, nếu không dùng SQLite local.
# local = luôn lưu DB/queue ở storage/, không cần Docker hay cài DB riêng.
# docker = bắt buộc Docker; custom = dùng DATABASE_URL và REDIS_URL bên dưới.
INFRA_MODE=auto
DATABASE_URL=
REDIS_URL=
STORAGE_DIR=storage

# yt-dlp download tu YouTube co the bi chan "Sign in to confirm you're not a
# bot". Cach KHUYEN DUNG: tu dong lay cookie bang Playwright, xem
# pipeline/infrastructure/browser_cookie_manager.py - chay 1 lan
# `python -m pipeline.infrastructure.browser_cookie_manager --setup` (mo
# trinh duyet that de dang nhap), sau do dung nut "Lam moi cookie" trong
# trang Admin (hoac --refresh) bat cu khi nao cookie het han. Mac dinh ghi
# vao cookies.txt o goc repo.
YTDLP_COOKIES_FILE=cookies.txt

# Cau hinh AI pipeline (pipeline/pipeline_settings.py) - doi WHISPER_MODEL sang
# large-v3 khi da xac nhan may dev chay duoc (xem HANDOFF.md Phase 1)
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8_float16
# Để trống để tự chọn CUDA nếu có, CPU nếu không.
PIPELINE_DEVICE=
PIPELINE_LANGUAGE=vi

# Che do van hanh mac dinh: CLOUD_FREE_API (0% GPU VRAM, qua Cloud APIs) hoac GPU_LOCAL
EXECUTION_MODE=CLOUD_FREE_API

# Groq API Key (SIEU TOC, STT Whisper Large-v3 MIEN PHI, 0% GPU VRAM)
# Tao key MIEN PHI tai: https://console.groq.com/keys
GROQ_API_KEY=

# Dich theo ngu canh bang Google Gemini (LLM) - TUY CHON. Co key: buoc dich
# tu dong dung Gemini (giu ngu canh/giong dieu xuyen suot video, xem
# pipeline/infrastructure/gemini_translator.py); khong co key hoac
# Gemini loi: tu fallback ve NLLB chay local nhu cu. Tao key MIEN PHI tai
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL frontend & backend
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
